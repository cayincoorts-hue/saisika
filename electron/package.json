{
  "name": "saisika",
  "version": "1.3.0",
  "description": "Saisca — 供应链风险分析系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac",
    "pack:win": "electron-builder --win",
    "pack:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.saisika.app",
    "productName": "Saisca",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../dist/saisika_backend",
        "to": "backend"
      }
    ],
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg",
      "icon": "icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  }
}
