# Saisca 自动发帖密钥配置
# 复制此文件为 .env，填入你的密钥

# --- Reddit ---
# 1. 打开 https://www.reddit.com/prefs/apps
# 2. 点 "create another app..."（页面底部）
# 3. 填：
#    name: saisca-poster
#    type: script
#    description: Auto-post saisca updates
#    about url: https://github.com/cayincoorts-hue/saisika
#    redirect uri: http://localhost:8080
# 4. 创建后你会看到 client_id（一长串乱码，在 app 名字下面）
#    和 secret（标着 "secret" 的字符串）
REDDIT_CLIENT_ID=你的client_id
REDDIT_CLIENT_SECRET=你的secret
REDDIT_USERNAME=你的reddit用户名
REDDIT_PASSWORD=你的reddit密码

# --- V2EX ---
# 1. 打开 https://www.v2ex.com/settings/tokens
# 2. 点 "Generate new token"
# 3. 勾选 "创建新主题" 权限
# 4. 复制生成的 token
V2EX_TOKEN=你的v2ex_token

# --- Dev.to ---
# 1. 打开 https://dev.to/settings/extensions
# 2. 翻到最下面 "API Keys"
# 3. 生成一个 key（name 随意填，比如 "auto-post"）
# 4. 复制 key
DEVTO_API_KEY=你的devto_api_key
