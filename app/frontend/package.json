{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_APP_MODE=demo tsc -b && VITE_APP_MODE=demo vite build",
    "lint": "eslint .",
    "preview": "vite preview",
